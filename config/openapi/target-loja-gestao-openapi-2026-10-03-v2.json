  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "Period": {
        "name": "period",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "examples": [
            "2026-09"
          ]
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisicao invalida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Nao autenticado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Perfil sem permissao",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso nao encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflito de estado ou estoque",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "GERENTE",
          "VENDEDOR"
        ]
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string",
            "const": "BRL"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "user"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserSession"
          }
        }
      },
      "UserSession": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "additionalProperties": false
      },
      "SellerMetric": {
        "type": "object",
        "required": [
          "sellerId",
          "sellerName",
          "goal",
          "realized",
          "achievementPercent"
        ],
        "properties": {
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "sellerName": {
            "type": "string"
          },
          "goal": {
            "$ref": "#/components/schemas/Money"
          },
          "realized": {
            "$ref": "#/components/schemas/Money"
          },
          "achievementPercent": {
            "type": "number"
          }
        }
      },
      "ManagementSummary": {
        "type": "object",
        "required": [
          "period",
          "storeGoal",
          "storeRealized",
          "achievementPercent",
          "team"
        ],
        "properties": {
          "period": {
            "type": "string"
          },
          "storeGoal": {
            "$ref": "#/components/schemas/Money"
          },
          "storeRealized": {
            "$ref": "#/components/schemas/Money"
          },
          "achievementPercent": {
            "type": "number"
          },
          "team": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerMetric"
            }
          },
          "stockAlerts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SellerPerformance": {
        "type": "object",
        "required": [
          "period",
          "seller",
          "goal",
          "realized",
          "achievementPercent"
        ],
        "properties": {
          "period": {
            "type": "string"
          },
          "seller": {
            "$ref": "#/components/schemas/UserSession"
          },
          "goal": {
            "$ref": "#/components/schemas/Money"
          },
          "realized": {
            "$ref": "#/components/schemas/Money"
          },
          "achievementPercent": {
            "type": "number"
          },
          "state": {
            "type": "string",
            "examples": [
              "Sem meta"
            ]
          }
        },
        "additionalProperties": false
      },
      "GoalDistribution": {
        "type": "object",
        "required": [
          "period",
          "storeGoal",
          "sellers"
        ],
        "properties": {
          "period": {
            "type": "string",
            "examples": [
              "2026-09"
            ]
          },
          "storeGoal": {
            "$ref": "#/components/schemas/Money"
          },
          "sellers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sellerId",
                "goal"
              ],
              "properties": {
                "sellerId": {
                  "type": "integer",
                  "format": "int64"
                },
                "goal": {
                  "$ref": "#/components/schemas/Money"
                }
              }
            }
          }
        }
      },
      "SalesOrderRequest": {
        "type": "object",
        "required": [
          "items",
          "payment",
          "shippingAddress"
        ],
        "properties": {
          "clientId": {
            "type": "integer",
            "format": "int64"
          },
          "client": {
            "type": "object",
            "additionalProperties": true
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity"
              ],
              "properties": {
                "productId": {
                  "type": "integer",
                  "format": "int64"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "payment": {
            "type": "object",
            "additionalProperties": true
          },
          "shippingAddress": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SalesOrderResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "seller",
          "items",
          "total"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "seller": {
            "$ref": "#/components/schemas/UserSession"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "integer",
                  "format": "int64"
                },
                "quantity": {
                  "type": "integer"
                },
                "unitPrice": {
                  "$ref": "#/components/schemas/Money"
                },
                "subtotal": {
                  "$ref": "#/components/schemas/Money"
                }
              },
              "additionalProperties": false,
              "required": [
                "productId",
                "quantity",
                "unitPrice",
                "subtotal"
              ]
            }
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "additionalProperties": false
      },
      "StockProduct": {
        "type": "object",
        "required": [
          "productId",
          "name",
          "physicalBalance",
          "reserved",
          "available",
          "salePrice"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "physicalBalance": {
            "type": "integer"
          },
          "reserved": {
            "type": "integer"
          },
          "available": {
            "type": "integer"
          },
          "salePrice": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "StockEntryRequest": {
        "type": "object",
        "required": [
          "quantity",
          "unitCost",
          "salePrice"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitCost": {
            "$ref": "#/components/schemas/Money"
          },
          "salePrice": {
            "$ref": "#/components/schemas/Money"
          },
          "source": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActionResult": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "timestamp",
          "status",
          "error",
          "message"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": [
              "array",
              "object",
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
